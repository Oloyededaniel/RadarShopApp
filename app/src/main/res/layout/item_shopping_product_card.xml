<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Product Image Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="8dp"
            android:background="@color/bg_light">

            <ImageView
                android:id="@+id/ivProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/product_placeholder"
                android:contentDescription="Product Image" />

            <!-- Wishlist Button -->
            <ImageButton
                android:id="@+id/btnWishlist"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="@drawable/circle_button_background"
                android:src="@drawable/ic_favorite_border"
                android:contentDescription="Add to Wishlist"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <!-- Savings Badge -->
            <TextView
                android:id="@+id/tvSavings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:background="@drawable/shopping_savings_badge"
                android:text="Save 20%"
                android:textColor="@android:color/white"
                android:textSize="8sp"
                android:textStyle="bold"
                android:padding="4dp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Product Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Product Name -->
            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginBottom="4dp" />

            <!-- Brand -->
            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Brand"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <!-- Rating -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:rating="0"
                    android:scaleX="0.6"
                    android:scaleY="0.6"
                    android:transformPivotX="0dp"
                    android:transformPivotY="0dp"
                    android:progressTint="@color/rating_color"
                    android:secondaryProgressTint="@color/text_muted"
                    style="?android:attr/ratingBarStyleSmall" />

                <TextView
                    android:id="@+id/tvRatingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0)"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginStart="4dp"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

            <!-- Price Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/price_color" />

                <TextView
                    android:id="@+id/tvOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginStart="8dp"
                    android:layout_gravity="center_vertical"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Add to Cart Button -->
                <Button
                    android:id="@+id/btnAddToCart"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="Add to Cart"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/shopping_add_to_cart_button"
                    android:textColor="@color/text_primary"
                    android:layout_marginEnd="4dp" />

                <!-- Quantity Controls -->
                <LinearLayout
                    android:id="@+id/layoutQuantityControls"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:background="@drawable/quantity_controls_background"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnDecrease"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_remove"
                        android:background="@drawable/circle_button_background"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:layout_margin="2dp" />

                    <TextView
                        android:id="@+id/tvQuantity"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:layout_margin="2dp" />

                    <ImageButton
                        android:id="@+id/btnIncrease"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_add"
                        android:background="@drawable/circle_button_background"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:layout_margin="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Stock Status -->
            <TextView
                android:id="@+id/tvStockStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In Stock"
                android:textSize="10sp"
                android:textColor="@color/success_green"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
