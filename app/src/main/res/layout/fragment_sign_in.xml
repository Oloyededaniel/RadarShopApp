<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:minHeight="400dp">

    <!-- Creative Welcome Message -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/brand_primary"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to continue your shopping journey"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:fontFamily="sans-serif-light"
            android:alpha="0.8"/>

    </LinearLayout>

    <!-- Email input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email Address"
        app:startIconDrawable="@android:drawable/ic_dialog_email"
        app:startIconTint="@color/brand_primary"
        app:hintTextColor="@color/brand_primary"
        app:boxStrokeColor="@color/brand_primary"
        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp"
        app:boxBackgroundColor="@android:color/white"
        app:boxStrokeWidth="2dp"
        android:layout_marginBottom="12dp"
        app:boxStrokeWidthFocused="3dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmailLogin"
            android:inputType="textEmailAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/txtPrimary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/brand_primary"
        app:hintTextColor="@color/brand_primary"
        app:boxStrokeColor="@color/brand_primary"
        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp"
        app:boxBackgroundColor="@android:color/white"
        app:boxStrokeWidth="2dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:boxStrokeWidthFocused="3dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPasswordLogin"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/txtPrimary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Creative remember me section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <CheckBox
            android:id="@+id/cbRemember"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Remember me"
            android:textColor="@color/txtPrimary"
            android:textSize="14sp"
            android:buttonTint="@color/brand_primary" />

        <TextView
            android:id="@+id/tvForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="Forgot password?"
            android:textColor="@color/brand_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

        <!-- Sign in button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignIn"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Sign In"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:cornerRadius="32dp"
            android:backgroundTint="@color/brand_primary"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="8dp"
            app:icon="@android:drawable/ic_secure"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            android:letterSpacing="0.1"/>

    </LinearLayout>
</ScrollView>
