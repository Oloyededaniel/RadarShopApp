<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/splash_background">

    <!-- Creative Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        android:background="@drawable/splash_gradient"
        android:minHeight="200dp">

        <!-- Animated Logo Container -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <!-- Background Glow Effect -->
            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/glow_effect"
                android:alpha="0.3" />

            <!-- Main Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/radarshop_logo"
                android:background="@drawable/circle_mask"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:contentDescription="@string/app_name"
                android:elevation="12dp" />

        </FrameLayout>

        <!-- Brand Text -->
        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RADARSHOP"
            android:textColor="@color/brand_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:fontFamily="sans-serif-medium"
            android:elevation="8dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Ultimate Shopping Experience Awaits"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif-light"
            android:alpha="0.9"
            android:gravity="center" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-40dp"
                android:layout_marginHorizontal="4dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="16dp"
                app:cardCornerRadius="32dp"
                app:cardPreventCornerOverlap="true"
                app:contentPadding="28dp"
                app:contentPaddingBottom="36dp"
                android:backgroundTint="@android:color/white"
                android:alpha="0.98">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Creative Welcome Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:id="@+id/tvWelcome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome to RadarShop"
                            android:textStyle="bold"
                            android:textSize="24sp"
                            android:textColor="@color/brand_primary"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sign in to your account or create a new one to start your amazing shopping journey"
                            android:textColor="@color/text_muted"
                            android:textSize="15sp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-light"
                            android:alpha="0.9"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"/>

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/tabLayout"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/segmented_tabs_background"
                            android:padding="8dp"
                            app:tabGravity="fill"
                            app:tabIndicator="@drawable/segmented_tab_indicator"
                            app:tabIndicatorFullWidth="false"
                            app:tabMode="fixed"
                            app:tabRippleColor="@android:color/transparent"
                            app:tabSelectedTextColor="@color/brand_primary"
                            app:tabTextColor="@color/text_muted" />

                    </LinearLayout>


                    <!-- Creative ViewPager2 -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPager"
                        android:layout_width="match_parent"
                        android:layout_height="500dp"
                        android:overScrollMode="never"
                        android:layout_marginTop="8dp"
                        android:scrollbars="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
